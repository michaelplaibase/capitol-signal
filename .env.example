# Copy to .env (git-ignored) and fill in as needed.

# Slack incoming webhook. Leave empty to keep dry-run only.
SLACK_WEBHOOK_URL=

# 1 = print notifications to stdout only (default, safe). 0 = actually POST to Slack.
DRY_RUN=1

# Only notify when amount_min (USD) is at least this value. 0 = no minimum.
MIN_AMOUNT=0

# 1 = only notify trades that have a resolved ticker symbol. 0 = include null-ticker trades.
REQUIRE_TICKER=1

# Comma-separated politician last names to watch (case-insensitive). Empty = all politicians.
WATCHLIST=

# Base URL of the locally running capitol-api service.
CAPITOL_API_URL=http://localhost:3000

# Optional: path to a capitol-api cache json for offline mode when the live service is down.
# Extension beyond the original prompt: lets main.py run House data without the Node server.
CAPITOL_API_CACHE=
